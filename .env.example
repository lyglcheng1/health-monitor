# ============================================================
# 健康数据监控环境变量样例：复制为 .env 后按需修改
# ============================================================

# 存储（默认即可，通常不用改）
# DATABASE_URL=sqlite+aiosqlite:///data/health.db
# DATA_DIR=data
# UPLOADS_DIR=data/uploads

# 上传限制（MB）
MAX_UPLOAD_SIZE_MB=20

# 品牌
SITE_TITLE=健康数据监控
SITE_TAGLINE=个人体检与病历数据管理

# 登录（配置 AUTH_PASSWORD 即开启登录；不配则本机/局域网免登录）
AUTH_USERNAME=admin
AUTH_PASSWORD=
# 会话签名密钥（不配则回落 AUTH_PASSWORD）
# AUTH_SECRET=
SESSION_TTL_HOURS=168

# LLM 调用通用超时（秒）；模型在「模型设置」页添加自定义模型，不走 .env
DEEPSEEK_TIMEOUT=60